// Generated from backend/app/models; render with: dot -Tpng -Gdpi=200 01-database.dot -o ../png/01-database.png
digraph database {
  graph [rankdir=LR, splines=spline, nodesep=0.5, ranksep=1.6, fontname="Helvetica", label=<<b>Enlace Vital - Database (PostgreSQL + PostGIS on Supabase, RLS on every table)</b>>, labelloc=t, fontsize=22, pad=0.4];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [color="#555555", dir=both, arrowsize=0.9];
  subgraph cluster_0 { label=<<b>Users</b>>; fontsize=16; style="rounded,filled"; fillcolor="#FDECEE"; color="#BBBBBB";
    users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="white"><tr><td colspan="3" bgcolor="#C8102E"><font color="white"><b>users</b></font></td></tr><tr><td port="id" align="left"><b>id</b></td><td align="left"><font color="#555555">uuid</font></td><td port="id_r" align="left"><font color="#C8102E" point-size="9">PK</font></td></tr><tr><td port="email" align="left">email</td><td align="left"><font color="#555555">citext</font></td><td port="email_r" align="left"><font color="#C8102E" point-size="9">UQ</font></td></tr><tr><td port="password_hash" align="left">password_hash</td><td align="left"><font color="#555555">varchar(255)</font></td><td port="password_hash_r" align="left"><font color="#C8102E" point-size="9"> </font></td></tr><tr><td port="name" align="left">name</td><td align="left"><font color="#555555">varchar(120)</font></td><td port="name_r" align="left"><font color="#C8102E" point-size="9"> </font></td></tr><tr><td port="phone" align="left">phone</td><td align="left"><font color="#555555">varchar(20)</font></td><td port="phone_r" align="left"><font color="#C8102E" point-size="9"> </font></td></tr><tr><td port="role" align="left">role</td><td align="left"><font color="#555555">user_role</font></td><td port="role_r" align="left"><font color="#C8102E" point-size="9"> </font></td></tr><tr><td port="created_at" align="left">created_at</td><td align="left"><font color="#555555">timestamptz</font></td><td port="created_at_r" align="left"><font color="#C8102E" point-size="9"> </font></td></tr><tr><td port="updated_at" align="left">updated_at</td><td align="left"><font color="#555555">timestamptz</font></td><td port="updated_at_r" align="left"><font color="#C8102E" point-size="9"> </font></td></tr></table>>];
    devices [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="white"><tr><td colspan="3" bgcolor="#C8102E"><font color="white"><b>devices</b></font></td></tr><tr><td port="id" align="left"><b>id</b></td><td align="left"><font color="#555555">uuid</font></td><td port="id_r" align="left"><font color="#C8102E" point-size="9">PK</font></td></tr><tr><td port="user_id" align="left">user_id</td><td align="left"><font color="#555555">uuid</font></td><td port="user_id_r" align="left"><font color="#C8102E" point-size="9">FK</font></td></tr><tr><td port="apns_token" align="left">apns_token</td><td align="left"><font color="#555555">varchar(255)</font></td><td port="apns_token_r" align="left"><font color="#C8102E" point-size="9">UQ</font></td></tr><tr><td port="platform" align="left">platform</td><td align="left"><font color="#555555">platform</font></td><td port="platform_r" align="left"><font color="#C8102E" point-size="9"> </font></td></tr><tr><td port="created_at" align="left">created_at</td><td align="left"><font color="#555555">timestamptz</font></td><td port="created_at_r" align="left"><font color="#C8102E" point-size="9"> </font></td></tr></table>>];
  }
