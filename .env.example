# Database used by the backend (FastAPI + Alembic)
# Supabase: Project → Connect → Session pooler; replace postgresql:// with postgresql+psycopg:// and add ?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Local Postgres for pytest (docker compose up -d); tests create and drop their own database next to it
TEST_DATABASE_URL=postgresql+psycopg://enlace_vital:change_me@localhost:5432/enlace_vital

# Local docker-compose database (only needed for tests or offline development)
POSTGRES_USER=enlace_vital
POSTGRES_PASSWORD=change_me
POSTGRES_DB=enlace_vital
PG_PORT=5432

# Supabase project (for clients that use the Supabase SDK; the backend doesn't need them)
SUPABASE_URL=https://fgmrcjbjxriqsmnnsrqy.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MEDICAL_DATA_KEY=
